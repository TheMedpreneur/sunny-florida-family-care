{
  "name": "sunny-florida-family-care",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run lint:error && vite build",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "check:i18n": "node scripts/check-translations.mjs",
    "preview": "vite preview",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "qa:a11y": "node scripts/a11y-qa.mjs",
    "qa": "npm run qa:mobile && npm run qa:a11y"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.62.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.2"
  }
}
