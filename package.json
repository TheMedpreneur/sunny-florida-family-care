{
  "name": "sunny-florida-family-care",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run lint:error && vite build",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "check:i18n": "node scripts/check-translations.mjs",
    "preview": "vite preview",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "qa:a11y": "node scripts/a11y-qa.mjs",
    "qa": "npm run qa:mobile && npm run qa:a11y",
    "deploy": "npm run build && wrangler pages deploy dist --project-name sunny-florida-family-care --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@dr.pogodin/react-helmet": "^3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^9.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.62.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.2",
    "wrangler": "^4.118.0"
  }
}
