# Cloudflare Pages headers
# ------------------------
# Applied at the edge. Cloudflare reads this file from the build output root.

/*
  # Stop the browser guessing content types (defends against MIME-confusion attacks)
  X-Content-Type-Options: nosniff
  # This site should never be framed — clickjacking a "Book Online" button is a real risk
  X-Frame-Options: DENY
  # Send the origin but not the full path to third parties
  Referrer-Policy: strict-origin-when-cross-origin
  # The site needs none of these; deny them rather than leave them available
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: on

# NOTE ON CSP
# A Content-Security-Policy is deliberately NOT set here yet. index.html uses an
# inline `onload` attribute for the non-blocking font swap, so any policy without
# 'unsafe-inline' in script-src silently breaks font loading — worse than no CSP.
# To add one properly: move that swap into a small external script, then set
#   Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Vite fingerprints these filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ana's photos and logo change rarely, but the names are not fingerprinted —
# a day of caching with revalidation keeps swaps quick.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

# Never cache the entry point, or a deploy will not go live for returning visitors.
#
# Under BrowserRouter every route below is also served index.html (see
# _redirects), so each one needs this rule too. "/" and "/index.html" alone
# would leave a returning visitor who bookmarked /services on a stale build
# — the exact failure this rule exists to prevent, just moved to the pages
# most likely to be linked.
#
# Listed path by path rather than as a wildcard: a broad rule here would also
# match /assets/* and /images/*, and the precedence between overlapping rules
# is not something to leave to chance when getting it wrong means either a
# stale deploy or uncached fingerprinted assets. Add a line when adding a route.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/team
  Cache-Control: public, max-age=0, must-revalidate

/services
  Cache-Control: public, max-age=0, must-revalidate

/services/*
  Cache-Control: public, max-age=0, must-revalidate

/faq
  Cache-Control: public, max-age=0, must-revalidate

/terms
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate
